    private static void showCreateTeamDialog() {
        JTextField teamNameField = new JTextField();
        teamNameField.setBackground(LIGHT_BLACK);
        teamNameField.setForeground(WHITE);

        Object[] message = {
            "Team Name:", teamNameField
        };

        int option = JOptionPane.showConfirmDialog(frame, message, "Create New Team", 
            JOptionPane.OK_CANCEL_OPTION, JOptionPane.PLAIN_MESSAGE);

        if (option == JOptionPane.OK_OPTION && !teamNameField.getText().trim().isEmpty()) {
            Team newTeam = new Team(teamNameField.getText().trim());
            newTeam.memberIds.add(currentUser.username);
            teams.put(newTeam.id, newTeam);
            currentUser.teamIds.add(newTeam.id);
            refreshTeamsList();
            showMessage("Team created successfully!", "Success", JOptionPane.INFORMATION_MESSAGE);
        }
    }

    private static void showAddNoteDialog() {
        JTextField titleField = new JTextField();
        titleField.setBackground(LIGHT_BLACK);
        titleField.setForeground(WHITE);

        JTextArea contentArea = new JTextArea(5, 20);
        contentArea.setBackground(LIGHT_BLACK);
        contentArea.setForeground(WHITE);
        contentArea.setLineWrap(true);
        JScrollPane contentScroll = new JScrollPane(contentArea);

        Object[] message = {
            "Title:", titleField,
            "Content:", contentScroll
        };

        int option = JOptionPane.showConfirmDialog(frame, message, "Add New Note", 
            JOptionPane.OK_CANCEL_OPTION, JOptionPane.PLAIN_MESSAGE);

        if (option == JOptionPane.OK_OPTION && !titleField.getText().trim().isEmpty()) {
            Note newNote = new Note(titleField.getText().trim(), contentArea.getText(), currentUser.username);
            currentTeam.notes.put(newNote.id, newNote);
            refreshNotesList();
            showMessage("Note added successfully!", "Success", JOptionPane.INFORMATION_MESSAGE);
        }
    }

    private static void loadTeamNotes(String teamName) {
        notesModel.clear();
        for (Team team : teams.values()) {
            if (team.name.equals(teamName)) {
                currentTeam = team;
                for (Note note : team.notes.values()) {
                    notesModel.addElement(note.title + "\n" + note.lastModified + "\nBy: " + note.author);
                }
                break;
            }
        }
    }

    private static void showNoteDetail(String noteTitle) {
        if (currentTeam != null) {
            for (Note note : currentTeam.notes.values()) {
                if (note.title.equals(noteTitle)) {
                    // Find the detail panel and update it
                    for (Component comp : cardPanel.getComponents()) {
                        if (comp instanceof JPanel && "NoteDetail".equals(((JPanel) comp).getName())) {
                            JPanel detailPanel = (JPanel) comp;
                            
                            // Update title
                            JPanel topPanel = (JPanel) detailPanel.getComponent(0);
                            JPanel titlePanel = (JPanel) topPanel.getComponent(1);
                            JLabel titleLabel = (JLabel) titlePanel.getComponent(0);
                            titleLabel.setText(note.title);
                            
                            // Update content
                            JScrollPane scrollPane = (JScrollPane) detailPanel.getComponent(1);
                            JTextArea contentArea = (JTextArea) scrollPane.getViewport().getView();
                            contentArea.setText(note.content);
                            contentArea.putClientProperty("noteId", note.id);
                            
                            break;
                        }
                    }
                    cardLayout.show(cardPanel, "NoteDetail");
                    break;
                }
            }
        }
    }

    private static void refreshTeamsList() {
        teamsModel.clear();
        if (currentUser != null) {
            for (String teamId : currentUser.teamIds) {
                Team team = teams.get(teamId);
                if (team != null) {
                    teamsModel.addElement(team.name);
                }
            }
        }
    }

    private static void refreshNotesList() {
        notesModel.clear();
        if (currentTeam != null) {
            for (Note note : currentTeam.notes.values()) {
                notesModel.addElement(note.title + "\n" + note.lastModified + "\nBy: " + note.author);
            }
        }
    }

    private static void showMessage(String message, String title, int messageType) {
        JOptionPane.showMessageDialog(frame, message, title, messageType);
    }

    // Custom cell renderers
    static class TeamListCellRenderer extends DefaultListCellRenderer {
        public Component getListCellRendererComponent(JList<?> list, Object value, int index, 
                                                    boolean isSelected, boolean cellHasFocus) {
            super.getListCellRendererComponent(list, value, index, isSelected, cellHasFocus);
            
            setBackground(isSelected ? SELECTION_BLUE : LIGHT_BLACK);
            setForeground(WHITE);
            setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));
            setFont(new Font("Arial", Font.BOLD, 16));
            
            return this;
        }
    }

    static class NoteListCellRenderer extends DefaultListCellRenderer {
        public Component getListCellRendererComponent(JList<?> list, Object value, int index, 
                                                    boolean isSelected, boolean cellHasFocus) {
            super.getListCellRendererComponent(list, value, index, isSelected, cellHasFocus);
            
            String text = value.toString();
            String[] parts = text.split("\n");
            
            if (parts.length >= 3) {
                setText("<html><b>" + parts[0] + "</b><br>" + 
                       "<font size='-1' color='#AAAAAA'>" + parts[1] + " • " + parts[2] + "</font></html>");
            }
            
            setBackground(isSelected ? SELECTION_BLUE : LIGHT_BLACK);
            setForeground(WHITE);
            setBorder(BorderFactory.createEmptyBorder(5, 10, 5, 10));
            
            return this;
        }
    }

    private static JButton createStyledButton(String text, Color bgColor) {
        JButton button = new JButton(text);
        button.setBackground(bgColor);
        button.setForeground(WHITE);
        button.setFocusPainted(false);
        button.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createLineBorder(bgColor.darker()),
            BorderFactory.createEmptyBorder(5, 15, 5, 15)
        ));
        return button;
    }
