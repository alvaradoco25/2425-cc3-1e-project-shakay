package com.mycompany.shakayproject;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.HashMap;
import java.util.Map;
import java.util.ArrayList;
import java.util.List;

public class ShakayProject {
    // Color Scheme
    private static final Color DARK_BLUE = new Color(0, 51, 102);
    private static final Color MEDIUM_BLUE = new Color(0, 102, 204);
    private static final Color LIGHT_BLUE = new Color(173, 216, 230);
    private static final Color DARK_BLACK = new Color(30, 30, 30);
    private static final Color LIGHT_BLACK = new Color(50, 50, 50);
    private static final Color WHITE = new Color(255, 255, 255);
    private static final Color SELECTION_BLUE = new Color(0, 122, 204);

    // App Components
    private static JFrame frame;
    private static CardLayout cardLayout;
    private static JPanel cardPanel;
    private static DefaultListModel<String> teamsModel = new DefaultListModel<>();
    private static DefaultListModel<String> notesModel = new DefaultListModel<>();
    private static Map<String, Team> teams = new HashMap<>();
    private static Map<String, User> users = new HashMap<>();
    private static User currentUser = null;
    private static Team currentTeam = null;

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            initializeSampleData();
            initializeUI();
        });
    }

    // Data Classes
    static class User {
        String username;
        String password;
        List<String> teamIds;

        public User(String username, String password) {
            this.username = username;
            this.password = password;
            this.teamIds = new ArrayList<>();
        }
    }

    static class Team {
        String id;
        String name;
        List<String> memberIds;
        Map<String, Note> notes;

        public Team(String name) {
            this.id = "team_" + System.currentTimeMillis();
            this.name = name;
            this.memberIds = new ArrayList<>();
            this.notes = new HashMap<>();
        }
    }

    static class Note {
        String id;
        String title;
        String content;
        String author;
        String lastModified;
        List<String> sharedWith;

        public Note(String title, String content, String author) {
            this.id = "note_" + System.currentTimeMillis();
            this.title = title;
            this.content = content;
            this.author = author;
            this.lastModified = LocalDate.now().format(DateTimeFormatter.ofPattern("dd MMM")) + " " + 
                             java.time.LocalTime.now().format(DateTimeFormatter.ofPattern("HH:mm"));
            this.sharedWith = new ArrayList<>();
        }
    }

    private static void initializeSampleData() {
        // Create sample users
        User admin = new User("admin", "admin123");
        User user1 = new User("user1", "password1");
        User user2 = new User("user2", "password2");
        
        users.put(admin.username, admin);
        users.put(user1.username, user1);
        users.put(user2.username, user2);

        // Create sample teams
        Team devTeam = new Team("Development Team");
        Team marketing = new Team("Marketing Team");
        
        // Add members to teams
        devTeam.memberIds.add(admin.username);
        devTeam.memberIds.add(user1.username);
        marketing.memberIds.add(admin.username);
        marketing.memberIds.add(user2.username);
        
        // Add teams to users
        admin.teamIds.add(devTeam.id);
        admin.teamIds.add(marketing.id);
        user1.teamIds.add(devTeam.id);
        user2.teamIds.add(marketing.id);
        
        // Add sample notes
        Note devNote = new Note("Project Timeline", "Finish UI by Friday\nBackend by next week", admin.username);
        Note marketingNote = new Note("Campaign Ideas", "1. Social media blitz\n2. Email campaign", user2.username);
        
        devTeam.notes.put(devNote.id, devNote);
        marketing.notes.put(marketingNote.id, marketingNote);
        
        // Store teams
        teams.put(devTeam.id, devTeam);
        teams.put(marketing.id, marketing);
    }

    private static void initializeUI() {
        try {
            UIManager.setLookAndFeel(UIManager.getSystemLookAndFeelClassName());
            setUIManagerProperties();
        } catch (Exception e) {
            e.printStackTrace();
        }

        frame = new JFrame("Team Notes App");
        frame.setSize(800, 600);
        frame.setLocationRelativeTo(null);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.getContentPane().setBackground(DARK_BLACK);

        cardLayout = new CardLayout();
        cardPanel = new JPanel(cardLayout);
        cardPanel.setBackground(DARK_BLACK);

        createLoginScreen();
        createTeamSelectionScreen();
        createNotesScreen();
        createNoteDetailScreen();
        createTeamManagementScreen();

        frame.add(cardPanel);
        frame.setVisible(true);
    }

    private static void setUIManagerProperties() {
        UIManager.put("Panel.background", DARK_BLACK);
        UIManager.put("Button.background", MEDIUM_BLUE);
        UIManager.put("Button.foreground", WHITE);
        UIManager.put("TextField.background", LIGHT_BLACK);
        UIManager.put("TextField.foreground", WHITE);
        UIManager.put("TextField.caretForeground", WHITE);
        UIManager.put("TextArea.background", LIGHT_BLACK);
        UIManager.put("TextArea.foreground", WHITE);
        UIManager.put("TextArea.caretForeground", WHITE);
        UIManager.put("List.background", LIGHT_BLACK);
        UIManager.put("List.foreground", WHITE);
        UIManager.put("List.selectionBackground", SELECTION_BLUE);
        UIManager.put("List.selectionForeground", WHITE);
        UIManager.put("ScrollPane.background", DARK_BLACK);
        UIManager.put("ScrollPane.border", BorderFactory.createEmptyBorder());
        UIManager.put("Label.foreground", WHITE);
        UIManager.put("OptionPane.background", DARK_BLACK);
        UIManager.put("OptionPane.messageForeground", WHITE);
    }

    private static void createLoginScreen() {
        JPanel loginPanel = new JPanel();
        loginPanel.setLayout(new BoxLayout(loginPanel, BoxLayout.Y_AXIS));
        loginPanel.setBorder(BorderFactory.createEmptyBorder(40, 40, 40, 40));
        loginPanel.setBackground(DARK_BLACK);

        JLabel titleLabel = new JLabel("Team Notes App", SwingConstants.CENTER);
        titleLabel.setFont(new Font("Arial", Font.BOLD, 24));
        titleLabel.setForeground(MEDIUM_BLUE);
        titleLabel.setAlignmentX(Component.CENTER_ALIGNMENT);

        JTextField usernameField = new JTextField();
        usernameField.setBorder(BorderFactory.createTitledBorder(
            BorderFactory.createLineBorder(MEDIUM_BLUE), "Username"));
        usernameField.setMaximumSize(new Dimension(300, 50));
        usernameField.setBackground(LIGHT_BLACK);
        usernameField.setForeground(WHITE);

        JPasswordField passwordField = new JPasswordField();
        passwordField.setBorder(BorderFactory.createTitledBorder(
            BorderFactory.createLineBorder(MEDIUM_BLUE), "Password"));
        passwordField.setMaximumSize(new Dimension(300, 50));
        passwordField.setBackground(LIGHT_BLACK);
        passwordField.setForeground(WHITE);

        JButton loginButton = createStyledButton("Login", MEDIUM_BLUE);
        loginButton.setAlignmentX(Component.CENTER_ALIGNMENT);
        loginButton.setMaximumSize(new Dimension(300, 40));

        JButton registerButton = createStyledButton("Register", DARK_BLUE);
        registerButton.setAlignmentX(Component.CENTER_ALIGNMENT);
        registerButton.setMaximumSize(new Dimension(300, 40));

        loginButton.addActionListener(e -> {
            String username = usernameField.getText().trim();
            String password = new String(passwordField.getPassword());
            
            if (username.isEmpty() || password.isEmpty()) {
                showMessage("Please enter both username and password", "Login Error", JOptionPane.ERROR_MESSAGE);
            } else if (users.containsKey(username) && users.get(username).password.equals(password)) {
                currentUser = users.get(username);
                refreshTeamsList();
                cardLayout.show(cardPanel, "Teams");
            } else {
                showMessage("Invalid username or password", "Login Error", JOptionPane.ERROR_MESSAGE);
            }
        });

        registerButton.addActionListener(e -> {
            String username = JOptionPane.showInputDialog(frame, "Enter username:", "Register", JOptionPane.PLAIN_MESSAGE);
            if (username != null && !username.trim().isEmpty()) {
                if (users.containsKey(username)) {
                    showMessage("Username already exists", "Registration Error", JOptionPane.ERROR_MESSAGE);
                } else {
                    String password = JOptionPane.showInputDialog(frame, "Enter password:", "Register", JOptionPane.PLAIN_MESSAGE);
                    if (password != null && !password.trim().isEmpty()) {
                        users.put(username, new User(username, password));
                        showMessage("Registration successful!", "Registration", JOptionPane.INFORMATION_MESSAGE);
                    }
                }
            }
        });

        loginPanel.add(titleLabel);
        loginPanel.add(Box.createRigidArea(new Dimension(0, 30)));
        loginPanel.add(usernameField);
        loginPanel.add(Box.createRigidArea(new Dimension(0, 15)));
        loginPanel.add(passwordField);
        loginPanel.add(Box.createRigidArea(new Dimension(0, 30)));
        loginPanel.add(loginButton);
        loginPanel.add(Box.createRigidArea(new Dimension(0, 10)));
        loginPanel.add(registerButton);

        cardPanel.add(loginPanel, "Login");
    }

    private static void createTeamSelectionScreen() {
        JPanel teamPanel = new JPanel(new BorderLayout());
        teamPanel.setBackground(DARK_BLACK);

        JLabel titleLabel = new JLabel("Select Your Team", SwingConstants.CENTER);
        titleLabel.setFont(new Font("Arial", Font.BOLD, 24));
        titleLabel.setForeground(MEDIUM_BLUE);
        titleLabel.setBorder(BorderFactory.createEmptyBorder(20, 0, 20, 0));

        JList<String> teamList = new JList<>(teamsModel);
        teamList.setCellRenderer(new TeamListCellRenderer());
        teamList.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
        teamList.setBackground(LIGHT_BLACK);
        teamList.setForeground(WHITE);
        
        teamList.addMouseListener(new MouseAdapter() {
            public void mouseClicked(MouseEvent evt) {
                if (evt.getClickCount() == 2) {
                    String selectedTeam = teamList.getSelectedValue();
                    if (selectedTeam != null) {
                        loadTeamNotes(selectedTeam);
                        cardLayout.show(cardPanel, "Notes");
                    }
                }
            }
        });

        JButton createTeamBtn = createStyledButton("Create New Team", MEDIUM_BLUE);
        createTeamBtn.addActionListener(e -> showCreateTeamDialog());

        JButton logoutBtn = createStyledButton("Logout", DARK_BLUE);
        logoutBtn.addActionListener(e -> {
            currentUser = null;
            cardLayout.show(cardPanel, "Login");
        });

        JPanel buttonPanel = new JPanel(new FlowLayout(FlowLayout.CENTER));
        buttonPanel.setBackground(DARK_BLACK);
        buttonPanel.add(createTeamBtn);
        buttonPanel.add(Box.createRigidArea(new Dimension(20, 0)));
        buttonPanel.add(logoutBtn);

        teamPanel.add(titleLabel, BorderLayout.NORTH);
        teamPanel.add(new JScrollPane(teamList), BorderLayout.CENTER);
        teamPanel.add(buttonPanel, BorderLayout.SOUTH);

        cardPanel.add(teamPanel, "Teams");
    }

    private static void createNotesScreen() {
        JPanel notesPanel = new JPanel(new BorderLayout());
        notesPanel.setBackground(DARK_BLACK);

        JLabel titleLabel = new JLabel("Team Notes", SwingConstants.CENTER);
        titleLabel.setFont(new Font("Arial", Font.BOLD, 24));
        titleLabel.setForeground(MEDIUM_BLUE);
        titleLabel.setBorder(BorderFactory.createEmptyBorder(15, 0, 15, 0));

        JList<String> notesList = new JList<>(notesModel);
        notesList.setCellRenderer(new NoteListCellRenderer());
        notesList.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
        notesList.setBackground(LIGHT_BLACK);
        notesList.setForeground(WHITE);
        
        notesList.addMouseListener(new MouseAdapter() {
            public void mouseClicked(MouseEvent evt) {
                if (evt.getClickCount() == 2) {
                    String selectedNote = notesList.getSelectedValue();
                    if (selectedNote != null) {
                        showNoteDetail(selectedNote.split("\n")[0]);
                    }
                }
            }
        });

        JButton addNoteBtn = createStyledButton("Add Note", MEDIUM_BLUE);
        addNoteBtn.addActionListener(e -> showAddNoteDialog());

        JButton backBtn = createStyledButton("Back to Teams", DARK_BLUE);
        backBtn.addActionListener(e -> cardLayout.show(cardPanel, "Teams"));

        JPanel buttonPanel = new JPanel(new FlowLayout(FlowLayout.CENTER));
        buttonPanel.setBackground(DARK_BLACK);
        buttonPanel.add(addNoteBtn);
        buttonPanel.add(Box.createRigidArea(new Dimension(20, 0)));
        buttonPanel.add(backBtn);

        notesPanel.add(titleLabel, BorderLayout.NORTH);
        notesPanel.add(new JScrollPane(notesList), BorderLayout.CENTER);
        notesPanel.add(buttonPanel, BorderLayout.SOUTH);

        cardPanel.add(notesPanel, "Notes");
    }

